# Multi-stage production build for UniCompute Coordinator
FROM golang:1.24-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o unicompute-coordinator ./cmd/coordinator

FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /build/unicompute-coordinator /app/unicompute-coordinator

EXPOSE 8443 10000
EXPOSE 3478/udp

ENTRYPOINT ["/app/unicompute-coordinator"]
CMD []
